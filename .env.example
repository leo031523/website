# Database
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=portfolio_db
DATABASE_URL=postgresql://portfolio:your_secure_password_here@db:5432/portfolio_db

# Auth
JWT_SECRET=your_jwt_secret_here_minimum_32_characters_long
REVALIDATE_SECRET=your_revalidate_secret_here_minimum_32_characters_long

# 用來加密資料庫中 AI provider API key 的 master key，遺失即無法解密、
# 只能請管理者到後台重新輸入一次 API key。與 JWT_SECRET 一樣，貼一串
# 隨機字串即可（至少 32 字元），不需要另外跑指令產生特定格式。
AI_MASTER_KEY=your_ai_master_key_here_minimum_32_characters_long

# 正式環境預設拒絕「OpenAI 相容服務」provider 的 Base URL 指向 loopback／
# 內網／metadata 位址（SSRF 防護）。只有真的需要連線到內網自架模型時才
# 需要設定，逗號分隔的主機名稱清單，例如：AI_LOCAL_MODEL_ALLOWLIST=ollama.internal
AI_LOCAL_MODEL_ALLOWLIST=

# App environment：development 或 production。
# 使用 docker-compose.prod.yml 時會自動覆蓋為 production 並要求
# COOKIE_SECURE=true；APP_ENV=production 但 JWT_SECRET/REVALIDATE_SECRET/
# AI_MASTER_KEY 仍為預設值或長度不足 32 字元時，後端會拒絕啟動。
APP_ENV=development

# 登入 Cookie 是否要求 Secure（僅透過 HTTPS 傳送）。
# 正式環境（有 HTTPS）務必設為 true；docker-compose.prod.yml 已預設帶入。
COOKIE_SECURE=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api
API_URL=http://backend:8000
SITE_URL=http://localhost

# CORS（逗號分隔，正式環境改為你的網域）
CORS_ORIGINS=http://localhost

# Frontend internal URL（後端觸發 ISR revalidate 用）
FRONTEND_URL=http://frontend:3000
